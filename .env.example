# ==============================================================
#  Antigravity ↔ OpenCode Multi-Agent Bridge 2.0 — Configuración
#  Copia este archivo a `.env` y completa los valores.
# ==============================================================

# --- Servidor Web / WebSocket ---
PORT=3000
HOST=localhost

# --- Google Antigravity (Arquitecto) ---
# API key de Google AI Studio (Gemini). Obligatoria para que Antigravity responda.
GEMINI_API_KEY=
ANTIGRAVITY_MODEL=gemini-2.5-flash

# --- OpenCode Desktop (Desarrollador) ---
# URL del servidor local de OpenCode (`opencode serve --port 4096`).
# Si no está levantado, el adaptador intenta iniciarlo automáticamente (solo Windows).
OPENCODE_URL=http://localhost:4096
OPENCODE_PASSWORD=
OPENCODE_MODEL=gemini-2.5-flash

# --- Antigravity Bridge (opcional, servidor Python compatible con OpenAI) ---
BRIDGE_PORT=11435
ANTIGRAVITY_APP_DIR=
