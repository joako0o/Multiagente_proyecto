# =============================================================================
#  Multi-Agent Bridge — configuración
#  Copia este archivo a `.env` y rellena lo que necesites.
#  Todo es opcional salvo la API key del arquitecto (Antigravity).
# =============================================================================

# ---- Servidor web / WebSocket ------------------------------------------------
PORT=3000
HOST=localhost

# ---- Ciclo de turnos ---------------------------------------------------------
# Máximo de turnos por defecto y pausa entre turnos (ms).
LOOP_MAX_TURNS=15
LOOP_DELAY_MS=3000
# Carpeta donde se guarda el historial .md de cada sesión y, en .sessions/,
# el estado .json que permite recuperar las sesiones tras un reinicio.
# HISTORY_DIR=./conversations
# SESSIONS_DIR=./conversations/.sessions

# ---- Antigravity (arquitecto / revisor) — OBLIGATORIO ------------------------
# Clave de Google AI Studio. También la reutilizan OpenHands y Aider si no se
# les da una propia.
GEMINI_API_KEY=

# Proveedor del arquitecto: `gemini` (API de Google) o `openai` (cualquier
# endpoint compatible: Ollama, LM Studio, el bridge Python incluido…).
ANTIGRAVITY_PROVIDER=gemini
ANTIGRAVITY_MODEL=gemini-2.5-flash
# Solo si ANTIGRAVITY_PROVIDER=openai:
# ANTIGRAVITY_BASE_URL=http://127.0.0.1:11434/v1
# ANTIGRAVITY_API_KEY=

# ---- OpenCode (desarrollador) — servidor HTTP local --------------------------
# Arranca con `opencode serve --port 4096`. Si no responde y OPENCODE_AUTO_START
# es true, el bridge intenta levantarlo.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER=google
OPENCODE_MODEL=gemini-2.5-flash
OPENCODE_AUTO_START=true

# ---- OpenHands (ingeniero autónomo) — CLI headless ---------------------------
# Instalación: `uv tool install openhands` (o `pip install openhands`).
# Modelo en formato LiteLLM (gemini/…, openai/…, anthropic/…, ollama/…).
# Si se deja vacío, OpenHands usa su propia configuración (~/.openhands).
# OPENHANDS_MODEL=gemini/gemini-2.5-flash
# OPENHANDS_API_KEY=
# OPENHANDS_BASE_URL=
# OPENHANDS_COMMAND=openhands

# ---- Aider (editor Git) — CLI ------------------------------------------------
# Instalación: `pip install aider-install && aider-install`.
# Modelo en formato LiteLLM. Por defecto usa Gemini con GEMINI_API_KEY.
# AIDER_MODEL=gemini/gemini-2.5-flash
# Clave en formato de aider `proveedor=clave` (por defecto `gemini=$GEMINI_API_KEY`).
# AIDER_API_KEY=openai=sk-...
# Para modelos `openai/…` contra un servidor local (Ollama, LM Studio, bridge):
# AIDER_MODEL=openai/qwen2.5-coder
# AIDER_BASE_URL=http://127.0.0.1:11434/v1
# Si true, Aider hace commit automático de cada cambio. Por defecto no.
AIDER_AUTO_COMMITS=false
# AIDER_COMMAND=aider

# ---- Open Interpreter (ejecución / QA) ---------------------------------------
# Opción A (recomendada): paquete Python  →  pip install open-interpreter
#   El bridge lo usa a través de src/scripts/interpreter_runner.py con el
#   intérprete indicado en INTERPRETER_PYTHON (útil si está en un venv).
# Opción B: binario nuevo de openinterpreter.com (`interpreter exec`).
# Si no hay ninguno, el agente funciona en modo limitado: ejecuta solo los
# comandos de prueba/build que el equipo proponga en bloques ```bash.
# INTERPRETER_PYTHON=python3
# INTERPRETER_MODEL=gemini/gemini-2.5-flash
# INTERPRETER_API_KEY=
# Para servidores locales OpenAI-compatibles:
# INTERPRETER_MODEL=openai/qwen2.5-coder
# INTERPRETER_API_BASE=http://127.0.0.1:11434/v1
# INTERPRETER_CONTEXT_WINDOW=128000
# INTERPRETER_MAX_TOKENS=4096
# INTERPRETER_COMMAND=interpreter

# ---- Timeouts por agente (ms) ------------------------------------------------
# ANTIGRAVITY_TIMEOUT_MS=60000
# OPENCODE_TIMEOUT_MS=180000
# OPENHANDS_TIMEOUT_MS=600000
# AIDER_TIMEOUT_MS=300000
# INTERPRETER_TIMEOUT_MS=300000

# ---- Skills (biblioteca de instrucciones + herramientas para los agentes) -----
# Formato Agent Skills (https://agentskills.io): carpetas con SKILL.md. El
# arquitecto ve el catálogo al planificar y asigna skills a cada agente con
# `[SKILLS: agente=skill,...]`; el bridge las copia a <workspace>/.agents/skills/
# (OpenHands y OpenCode las cargan solos; al resto se les inyectan en el prompt).
SKILLS_ENABLED=true
# Repositorios Git con skills: `owner/repo`, `owner/repo@rama` o URL, separados por comas.
# Ejemplos: anthropics/skills (documentos, pruebas web…), microsoft/skills (Azure, SDKs).
SKILLS_SOURCES=anthropics/skills
# Dónde se clonan (ignorado por git). Skills personales: <cache>/local/<name>/SKILL.md
SKILLS_CACHE_DIR=./.skills-cache
# Clonar/actualizar al arrancar. Ponlo en false si trabajas sin conexión.
SKILLS_SYNC_ON_START=true
# Carpetas del proyecto con skills incluidas (econometría, APIs financieras, d3).
# SKILLS_BUNDLED_DIRS=./skills

# ---- Antigravity Bridge (opcional, servidor Python OpenAI-compatible) --------
BRIDGE_PORT=11435
