# =============================================================================
#  Multi-Agent Bridge — configuración
#  Copia este archivo a `.env` y rellena lo que necesites.
#  Todo es opcional salvo la API key del arquitecto (Antigravity).
# =============================================================================

# ---- Servidor web / WebSocket ------------------------------------------------
PORT=3000
HOST=localhost

# ---- Ciclo de turnos ---------------------------------------------------------
# Máximo de turnos por defecto y pausa entre turnos (ms).
LOOP_MAX_TURNS=15
LOOP_DELAY_MS=3000
# Carpeta donde se guarda el historial .md de cada sesión.
# HISTORY_DIR=./conversations

# ---- Antigravity (arquitecto / revisor) — OBLIGATORIO ------------------------
# Clave de Google AI Studio. También la reutilizan OpenHands y Aider si no se
# les da una propia.
GEMINI_API_KEY=

# Proveedor del arquitecto: `gemini` (API de Google) o `openai` (cualquier
# endpoint compatible: Ollama, LM Studio, el bridge Python incluido…).
ANTIGRAVITY_PROVIDER=gemini
ANTIGRAVITY_MODEL=gemini-2.5-flash
# Solo si ANTIGRAVITY_PROVIDER=openai:
# ANTIGRAVITY_BASE_URL=http://127.0.0.1:11434/v1
# ANTIGRAVITY_API_KEY=

# ---- OpenCode (desarrollador) — servidor HTTP local --------------------------
# Arranca con `opencode serve --port 4096`. Si no responde y OPENCODE_AUTO_START
# es true, el bridge intenta levantarlo.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER=google
OPENCODE_MODEL=gemini-2.5-flash
OPENCODE_AUTO_START=true

# ---- OpenHands (ingeniero autónomo) — CLI headless ---------------------------
# Instalación: `uv tool install openhands` (o `pip install openhands`).
# Modelo en formato LiteLLM (gemini/…, openai/…, anthropic/…, ollama/…).
# Si se deja vacío, OpenHands usa su propia configuración (~/.openhands).
# OPENHANDS_MODEL=gemini/gemini-2.5-flash
# OPENHANDS_API_KEY=
# OPENHANDS_BASE_URL=
# OPENHANDS_COMMAND=openhands

# ---- Aider (editor Git) — CLI ------------------------------------------------
# Instalación: `pip install aider-install && aider-install`.
# AIDER_MODEL=gemini/gemini-2.5-flash
# Si true, Aider hace commit automático de cada cambio. Por defecto no.
AIDER_AUTO_COMMITS=false
# AIDER_COMMAND=aider

# ---- Open Interpreter (ejecución / QA) — CLI ---------------------------------
# Instalación: ver https://www.openinterpreter.com/docs/terminal/install
# Si no está instalado, el agente funciona en modo limitado: ejecuta solo los
# comandos de prueba/build que el equipo proponga en bloques ```bash.
# INTERPRETER_MODEL=
# INTERPRETER_COMMAND=interpreter

# ---- Timeouts por agente (ms) ------------------------------------------------
# ANTIGRAVITY_TIMEOUT_MS=60000
# OPENCODE_TIMEOUT_MS=180000
# OPENHANDS_TIMEOUT_MS=600000
# AIDER_TIMEOUT_MS=300000
# INTERPRETER_TIMEOUT_MS=300000

# ---- Antigravity Bridge (opcional, servidor Python OpenAI-compatible) --------
BRIDGE_PORT=11435
